ACTUAL_SERVER_URL="server url"
ACTUAL_SERVER_PASSWORD="server password"
ACTUAL_SYNC_ID=
ACTUAL_FILE_PASSWORD=

# Default "0 */4 * * *"; override per task with <TASK>_CRON, e.g. FIX_PAYEES_CRON
CRON_EXPRESSION=
FIX_PAYEES_CRON=
RUN_ON_START=

# Optional: notify when a task fails.
# Space-separated Watchtower-style URLs, see README (telegram://, discord://, slack://, smtp://, ntfy://, gotify://, generic+https://)
NOTIFICATION_URL=

# Set to 1 to show the Actual API's verbose logs
DEBUG=

ENABLE_PAYEE_RENAME=
PAYEE_REGEX_MATCH=

ENABLE_INTEREST_CALCULATION=
# Annual rate in % multiplied by 1000 (5.399% -> 5399)
INTEREST_RATE=
MORTGAGE_PAYEE_ID=
MORTGAGE_PAYEE_NAME=
MORTGAGE_ACCOUNT_ID=
MAIN_ACCOUNT_ID=

